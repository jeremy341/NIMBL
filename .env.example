# NIMBL Environment Variables
# Copy this to .env and fill in your API keys

# Provider: OpenRouter (recommended for getting started)
# Get key at: https://openrouter.ai/keys
OPENROUTER_KEY=sk-or-v1-xxxxxxxxxxxxxxxxx

# Provider: FreeLLMAPI (auto-router with free/paid models)
# Get key at: https://freellmapi.com (or self-host)
FREELLMAPI_KEY=freellmapi-xxxxxxxxxxxxxxxxx

# Optional: Set default provider (defaults to freellmapi)
# NIMBL_PROVIDER=openrouter

# Optional: Set default model (overrides provider default)
# NIMBL_MODEL=deepseek/deepseek-chat

# Uncomment below for local development only
# WARNING: Never commit real keys to version control
